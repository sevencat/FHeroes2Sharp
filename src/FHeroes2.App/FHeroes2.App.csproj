<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FHeroes2.App</RootNamespace>
    <AssemblyName>FHeroes2Sharp</AssemblyName>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- Windows x64 only for now (docs/DECISIONS.md ADR-025): the native SDL3 / SDL3_ttf binaries
         are resolved per runtime identifier, and the window + taskbar icon code is only exercised
         there. The identifier is kept out of the output path so that
         tools/scripts/VerifyMenuBaseline.ps1 keeps finding bin/Debug/net10.0/FHeroes2Sharp.exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- One file, two consumers: Explorer reads it as the Win32 icon resource of the executable and
         SdlPresenter embeds the same bytes to build the window icon (SDL_SetWindowIcon). Regenerate
         it with tools/scripts/GenerateAppIcon.ps1 after changing assets/logo.png. -->
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL3-CS brings the C# bindings; the two Native packages ship SDL3.dll / SDL3_ttf.dll
         (and the .so/.dylib equivalents) per runtime identifier, so no manual copying is needed. -->
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Native" />
    <PackageReference Include="SDL3-CS.Native.TTF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FHeroes2.Core\FHeroes2.Core.csproj" />
    <ProjectReference Include="..\FHeroes2.Assets\FHeroes2.Assets.csproj" />
    <ProjectReference Include="..\FHeroes2.Rendering\FHeroes2.Rendering.csproj" />
    <ProjectReference Include="..\FHeroes2.Game\FHeroes2.Game.csproj" />
    <ProjectReference Include="..\FHeroes2.UI\FHeroes2.UI.csproj" />
  </ItemGroup>

  <!-- Bundled, redistributable fonts only (SIL OFL). Game assets are never copied. -->
  <ItemGroup>
    <None Include="..\..\assets\fonts\**\*.*" Link="assets\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The window icon travels inside the assembly: SdlPresenter reads it through
       WindowIcon, so a published folder stays a single executable plus the native SDL libraries
       and nothing has to be found next to it. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\logo.ico" LogicalName="logo.ico" />
  </ItemGroup>

</Project>
