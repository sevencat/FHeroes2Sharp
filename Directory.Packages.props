<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rendering / windowing / audio: SDL3 bindings plus the native SDL3, SDL3_ttf and SDL3_mixer
         binaries for every desktop target (win-x64/arm64, linux-x64/arm64, osx-x64/arm64). The
         Mixer bindings themselves ship inside SDL3-CS; only the native library is separate. -->
    <PackageVersion Include="SDL3-CS" Version="3.4.20" />
    <PackageVersion Include="SDL3-CS.Native" Version="3.4.2" />
    <PackageVersion Include="SDL3-CS.Native.TTF" Version="3.3.0" />
    <PackageVersion Include="SDL3-CS.Native.Mixer" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts: pure managed TrueType rasterizer with an embedded CJK face (WenQuanYi Micro Hei).
         No native library, no system font lookup, AOT safe; backs TrueTypeGlyphSource. -->
    <PackageVersion Include="Sevencat.GlyphRaster" Version="0.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
