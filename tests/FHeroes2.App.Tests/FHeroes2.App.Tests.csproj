<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FHeroes2.App.Tests</RootNamespace>
    <AssemblyName>FHeroes2.App.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- The application is a win-x64 executable (ADR-025) and a project that references it has to
         name the same runtime identifier. The identifier stays out of the output path so that
         `dotnet test` keeps writing to bin/Debug/net10.0 like the other test projects. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FHeroes2.App\FHeroes2.App.csproj" />
  </ItemGroup>

  <!-- The scene types reach the SDL side of the application (GameFonts, the presenter), which is
       annotated with SupportedOSPlatform("windows") per ADR-025. Stamping the same attribute on the
       test assembly keeps CA1416 quiet without repeating it on every test class. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
